### `Dockerfile` ```Dockerfile # Usar una imagen base de Python FROM python:3.8-slim # Establecer el directorio de trabajo WORKDIR /app # Copiar los requisitos y instalarlos COPY requirements.txt . RUN pip install --no-cache-dir -r requirements.txt # Copiar el resto del código COPY . . # Exponer el puerto en el que la aplicación escuchará EXPOSE 5000 # Comando para ejecutar la aplicación CMD ["python", "shield_gpt.py"]
